@page "/"
@rendermode InteractiveServer

<PageTitle>Lights Plugin Agent</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1>💡 Lights Plugin Agent</h1>
            <p class="lead">This AI agent can help you control and monitor lights in different rooms. Ask questions about light states or request changes.</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <strong>Try these example prompts:</strong>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-outline-primary btn-sm" @onclick='() => SetPrompt("Is the Entrance light on?")'>
                            Is the Entrance light on?
                        </button>
                        <button class="btn btn-outline-primary btn-sm" @onclick='() => SetPrompt("Turn on the Outside light.")'>
                            Turn on the Outside light.
                        </button>
                        <button class="btn btn-outline-primary btn-sm" @onclick='() => SetPrompt("Change the color of the Main Stage light to blue.")'>
                            Change the color of the Main Stage light to blue.
                        </button>
                        <button class="btn btn-outline-primary btn-sm" @onclick='() => SetPrompt("Set the brightness of the Second Stage light to low.")'>
                            Set the brightness of the Second Stage light to low.
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <strong>🔆 Current Light Status</strong>
                </div>
                <div class="card-body">
                    @if (lights != null && lights.Any())
                    {
                        <div class="row">
                            @foreach (var light in lights)
                            {
                                <div class="col-md-6 col-lg-3 mb-3">
                                    <div class="card h-100 @(light.IsOn == true ? "border-success" : "border-secondary")">
                                        <div class="card-body text-center">
                                            <div class="mb-2">
                                                <span style="font-size: 3rem; color: @(light.IsOn == true ? light.Color : "#CCCCCC"); background-color:  @(light.IsOn == true ? light.Color : "#FFFFFF")">
                                                    💡
                                                </span>
                                            </div>
                                            <h5 class="card-title">@light.Name</h5>
                                            <div class="mb-2">
                                                <span class="badge @(light.IsOn == true ? "bg-success" : "bg-secondary")">
                                                    @(light.IsOn == true ? "ON" : "OFF")
                                                </span>
                                            </div>
                                            @if (light.IsOn == true)
                                            {
                                                <div class="small text-muted">
                                                    <div>Brightness: <strong>@light.Brightness</strong></div>
                                                    <div>Color: <strong>@light.Color</strong></div>
                                                </div>
                                            }else
                                            {
												<div class="small text-muted">
                                                    <div>Brightness: <strong>N/A</strong></div>
                                                    <div>Color: <strong>@light.Color</strong></div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Loading lights...</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <strong>💬 Chat with Agent</strong>
                </div>
                <div class="card-body">
                    <div class="chat-container mb-3" style="height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 1rem; background-color: #f8f9fa;">
                        @if (chatMessages.Any())
                        {
                            @foreach (var message in chatMessages)
                            {
                                <div class="mb-3 @(message.IsUser ? "text-end" : "text-start")">
                                    <div class="d-inline-block @(message.IsUser ? "bg-primary text-white" : "bg-white") p-2 rounded" style="max-width: 70%; @(message.IsUser ? "" : "border: 1px solid #dee2e6;")">
                                        <div class="small fw-bold mb-1">@(message.IsUser ? "You" : "🤖 Agent")</div>
                                        <div>@message.Text</div>
                                        <div class="small text-muted mt-1">@message.Timestamp.ToString("HH:mm:ss")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center">Start a conversation by typing a message below...</p>
                        }
                        <div @ref="chatEndRef"></div>
                    </div>

                    <EditForm Model="@userInput" OnValidSubmit="HandleValidSubmit" FormName="LightsAgentChatForm">
                        <div class="input-group">
                            <InputTextArea @bind-Value="userInput.Message"
                                class="form-control" 
                                placeholder="Type your message here... (Ctrl+Enter to send)" 
                                Rows="2"
                                disabled="@isLoading" />
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Sending...</span>
                                }
                                else
                                {
                                    <span>Send</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-container {
        scroll-behavior: smooth;
    }
</style>

@code {
    private class UserInputModel
    {
        public string Message { get; set; } = string.Empty;
    }

    private class ChatMessage
    {
        public string Text { get; set; } = string.Empty;
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; }
    }

    private UserInputModel userInput = new();
    private List<ChatMessage> chatMessages = new();
    private List<LightPluginDemo.Web.Components.Plugins.LightModel>? lights;
    private bool isLoading = false;
    private ElementReference chatEndRef;

    [Inject]
    private LightPluginDemo.Web.Components.Contollers.LightPluginAgentContoller LightAgentController { get; set; } = default!;

    [Inject]
    private LightPluginDemo.Web.Components.Plugins.LightsPlugin LightsPlugin { get; set; } = default!;

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await RefreshLightsAsync();
    }

    private async Task RefreshLightsAsync()
    {
        lights = await LightsPlugin.GetLightsAsync();
        StateHasChanged();
    }

    private void SetPrompt(string prompt)
    {
        userInput.Message = prompt;
    }

    private async Task HandleValidSubmit()
    {
        await SubmitPromptAsync(userInput.Message);
    }

    private async Task SubmitPromptAsync(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt)) return;

        isLoading = true;

        // Add user message to chat
        chatMessages.Add(new ChatMessage
        {
            Text = prompt,
            IsUser = true,
            Timestamp = DateTime.Now
        });

        userInput.Message = string.Empty;
        StateHasChanged();

        try
        {
            // Get response from agent
            var response = await LightAgentController.AskLightAgentAsync(prompt);

            // Add agent response to chat
            chatMessages.Add(new ChatMessage
            {
                Text = response,
                IsUser = false,
                Timestamp = DateTime.Now
            });

            // Refresh lights to show any changes
            await RefreshLightsAsync();
        }
        catch (Exception ex)
        {
            chatMessages.Add(new ChatMessage
            {
                Text = $"Error: {ex.Message}",
                IsUser = false,
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();

            // Scroll to bottom of chat
            await Task.Delay(100);
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('.chat-container').scrollTop = document.querySelector('.chat-container').scrollHeight");
            }
            catch
            {
                // Ignore JS errors
            }
        }
    }
}

